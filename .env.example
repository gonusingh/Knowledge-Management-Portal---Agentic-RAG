# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY=
# Optional: used only when a saved Portkey config is selected.
GROQ_FALLBACK_API_KEY=
# Portkey LLM Gateway
# Optional: leave blank to call Groq directly.
PORTKEY_API_KEY=
# Saved Portkey config slug, e.g. pc-... (required when inline configs are blocked)
PORTKEY_CONFIG=
# Qdrant Vector DB
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
# Optional observability credentials
LOGFIRE_TOKEN=
# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Streamlit UI -> FastAPI
BACKEND_URL=http://localhost:8000
# Set true only when running the local demo identity selector.
DEMO_AUTH_ENABLED=false
# Public role selector is intended for the deployed demo; anyone can select
# Administrator. Keep the API protected by BACKEND_SHARED_SECRET.
PUBLIC_ROLE_SELECTOR=false
# Production API-to-UI shared secret and comma-separated allowed Google accounts.
# Configure these as host secrets; never commit real values.
BACKEND_SHARED_SECRET=
PORTAL_ALLOWED_EMAILS=
# Optional eval judge LLM (kept separate from the main app key)
JUDGE_GROQ=
# Gemini Embeddings
GEMINI_API_KEY=
# Logs raw model and guardrail text for local debugging; keep disabled otherwise.
GUARDRAIL_DEBUG_LOGGING=false
