# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
# Portkey LLM Gateway
PORTKEY_API_KEY=
# Saved Portkey config slug, e.g. pc-... (required when inline configs are blocked)
PORTKEY_CONFIG=
# Qdrant Vector DB
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
# Pydantic Logfire Observability
LOGFIRE_TOKEN=
# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Streamlit UI -> FastAPI
BACKEND_URL=http://localhost:8000
# Local-only simulated user identities; do not enable as production authentication.
DEMO_AUTH_ENABLED=false
# Eval judge LLM (kept separate from the main app key)
JUDGE_GROQ=
# Gemini Embeddings
GEMINI_API_KEY=
# Logs raw model and guardrail text for local debugging; keep disabled otherwise.
GUARDRAIL_DEBUG_LOGGING=false
